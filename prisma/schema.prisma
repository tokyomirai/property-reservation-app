generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/// 社内保有のキーボックス番号マスタ。
/// 物件側の「管理番号(keyBoxNumber)」と照合して在庫状況を判定する。
/// 先頭ゼロを保持するため number は文字列で持つ（例: "0925"）。
model KeyBox {
  id        String   @id @default(cuid())
  number    String   @unique
  notes     String   @default("")
  isActive  Boolean  @default(true)
  // 社内在庫時の保管場所（"4F" または自由入力）。空文字＝未設定（既存データは勝手に4Fにしない）。
  storageLocation String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// キーボックスの回収待ち／回収履歴。物件を売却済みにした時や手動で登録する。
/// 物件を削除しても参照できるよう、物件名・設置場所・解除番号はスナップショットで保存する。
/// status が「回収待ち」の番号は、在庫照合で「社内在庫」に戻さない（回収完了まで保持）。
model KeyBoxRecovery {
  id             String   @id @default(cuid())
  // 備品種別: キーボックス / スリッパ / 売り看板（既存データはキーボックス）
  itemType       String   @default("キーボックス")
  // キーボックスの所有区分: 自社 / 他社（金）。他社は「返却」管理で社内在庫に戻さない。既存は自社。
  ownership      String   @default("自社")
  // キーボックスのみ番号を持つ。スリッパ・売り看板は空文字（番号・個数は管理しない）。
  keyBoxNumber   String
  // 物件のスナップショット（物件削除後も残す）
  propertyId     String   @default("")
  propertyName   String   @default("")
  propertyAddress String  @default("")
  setupLocation  String   @default("")
  unlockCode     String   @default("")
  // 回収待ち | 回収済み
  status         String   @default("回収待ち")
  // 回収待ちにした人・日時（売却済み化やマニュアル登録の操作者）
  requestedBy    String   @default("")
  requestedAt    DateTime @default(now())
  // 回収完了時の回収者・回収日
  recoveredBy    String   @default("")
  recoveredAt    DateTime?
  // 回収した時点で戻した社内保管場所（"4F"/自由入力）。後からマスタの保管場所を変えても当時の戻し先が残る。
  recoveredLocation String @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([keyBoxNumber])
}

/// キーボックスの使用履歴（設置・変更・解除・回収）。物件管理画面での番号／解除番号／設置場所の
/// 変更から自動記録する（入力項目は増やさない）。append-only で、当時の値をそのまま残す。
model KeyBoxHistory {
  id            String   @id @default(cuid())
  keyBoxNumber  String
  // 設置 / 変更 / 解除 / 回収
  action        String
  propertyId    String   @default("")
  propertyName  String   @default("")
  setupLocation String   @default("")
  unlockCode    String   @default("")
  // 操作した担当者（ログインユーザー名）
  operator      String   @default("")
  createdAt     DateTime @default(now())

  @@index([keyBoxNumber])
}

model Property {
  id               String            @id @default(cuid())
  name             String
  address          String            @default("")
  salesStatus      String            @default("販売中")
  // 仕入決済前（契約済だが決済前で公開・販売停止）。販売状況から分離した専用フラグ。
  isAcquisitionPending Boolean        @default(false)
  viewingStatus    String            @default("内見可能")
  // 内見受付開始日（"YYYY-MM-DD"）。未設定(NULL)なら従来どおり日付制限なし。既存物件へは自動設定しない。
  viewingStartDate String?
  isPublished      Boolean           @default(true)
  // 売却済み（物理削除せず保管）。NULL=未売却。セット時に非公開・一覧除外・新規予約停止。履歴は保持。
  soldAt           DateTime?
  soldBy           String            @default("")
  hasKeyBox        String            @default("")
  keyBoxNumber     String            @default("")
  unlockCode       String            @default("")
  setupLocation    String            @default("")
  hasSlippers      String            @default("")
  hasSignboard     String            @default("")
  notes            String            @default("")
  internalMemo     String            @default("")
  salesRepEmail    String            @default("")
  // 公開物件カードの資料/動画/パノラマ導線（いずれも公開用URL。未登録なら空文字）
  documentUrl      String            @default("")
  youtubeUrl       String            @default("")
  panoramaUrl      String            @default("")
  lastUpdatedBy    String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reservations     Reservation[]
  internalBookings InternalBooking[]
}

model Reservation {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  propertyName  String
  companyName   String
  agentName     String
  /// 仲介会社の代表電話番号
  phone         String
  /// 仲介会社ご担当者の携帯番号（申込時必須）
  mobilePhone   String   @default("")
  email         String
  /// 申込時にアップロードされた担当者の名刺。社内のみ閲覧可。
  cardFileName  String   @default("")
  cardMimeType  String   @default("")
  /// 名刺ファイルの中身（Base64）
  cardData      String   @default("")
  preferredDate String
  // 表示用の時間ラベル（"10:00〜11:00"）。startTime/endTime から生成する。
  preferredTime String
  // 実際の予約枠。重複チェック・カレンダー登録はこの2項目を基準に行う。
  startTime     String   @default("")
  endTime       String   @default("")
  notes         String   @default("")
  status        String   @default("未承認")
  // 最終処理者（承認/却下/日時変更/キャンセルを実行したログインユーザー）。過去データは空＝記録なし。
  processedByName  String   @default("")
  processedByEmail String   @default("")
  processedAt      DateTime?
  // LINE WORKSカレンダーへ登録した予定のID（重複登録の防止・追跡用）
  calendarEventId String @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, preferredDate])
}

/// 管理画面から手動登録する予約。仲介会社には一切公開しない。
/// bookingType で「自社案内」「仲介案内（アプリ外）」を区別する。
/// 既存データは bookingType のデフォルト「自社案内」として扱われる。
model InternalBooking {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  propertyName String
  // 予約種別: "自社案内" | "仲介案内"（既存データは自社案内）
  bookingType  String   @default("自社案内")
  // 自社案内: 弊社の案内担当者名
  staffName    String
  // 仲介案内（アプリ外）用: 仲介会社情報
  companyName  String   @default("")
  agentName    String   @default("")
  phone        String   @default("")
  mobilePhone  String   @default("")
  email        String   @default("")
  date         String
  startTime    String
  endTime      String
  notes        String   @default("")
  // 確定 / キャンセル。キャンセルは枠を占有せず、カレンダー上はグレー表示（履歴は残す）。
  status       String   @default("確定")
  // LINE WORKSカレンダーに登録した予定のID（日時変更・キャンセル時の同期用）
  calendarEventId String @default("")
  // 登録者（この手動予約を登録したログインユーザー）
  createdBy    String   @default("")
  createdByEmail String @default("")
  // 最終処理者（日時変更/キャンセルを実行したログインユーザー）。過去データは空＝記録なし。
  processedByName  String   @default("")
  processedByEmail String   @default("")
  processedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId, date])
}

/// 予約に対する操作の監査ログ。誰が・いつ・何を・変更前後を記録する。
/// 既存予約は記録せず今後の操作分から蓄積する。予約削除後もログは残る（targetId は削除済みIDを指す）。
model OperationLog {
  id            String   @id @default(cuid())
  // 対象種別: "reservation"（内見予約） | "internalBooking"（社内手動予約）
  targetType    String
  targetId      String
  // 操作: 承認 / 却下 / 日時変更 / キャンセル / 削除 / 登録 / 確定 など
  action        String
  // 操作したログインユーザー（Google表示名。取得できなければ空）とメールアドレス
  operatorName  String   @default("")
  operatorEmail String   @default("")
  // 変更前・変更後の内容（表示用テキスト。ステータス名や "19:00〜20:00" など）
  beforeValue   String   @default("")
  afterValue    String   @default("")
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
}
